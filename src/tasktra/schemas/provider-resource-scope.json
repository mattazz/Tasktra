{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tasktra provider resource scope",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider", "host", "container", "resource_kind", "resource", "ref"],
  "properties": {
    "provider": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "host": {"type": "string", "minLength": 1, "maxLength": 253},
    "container": {"type": "string", "minLength": 1, "maxLength": 240},
    "resource_kind": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "resource": {"type": ["string", "null"], "minLength": 1, "maxLength": 240},
    "ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 240}
  }
}
