{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tasktra structured handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "handoff_id",
    "source",
    "producer",
    "human_summary",
    "status",
    "verified_facts",
    "inferences",
    "changed_paths",
    "validation_results",
    "evidence_refs",
    "blockers",
    "downstream_brief",
    "requested_actions"
  ],
  "properties": {
    "kind": {"const": "tasktra.handoff"},
    "version": {"const": 1},
    "handoff_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "source": {"$ref": "#/$defs/source"},
    "producer": {"$ref": "#/$defs/producer"},
    "human_summary": {"type": "string", "minLength": 1, "maxLength": 1200},
    "status": {"$ref": "#/$defs/status"},
    "verified_facts": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/fact"}},
    "inferences": {"type": "array", "maxItems": 24, "items": {"$ref": "#/$defs/inference"}},
    "changed_paths": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/changedPath"}},
    "validation_results": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/validation"}},
    "evidence_refs": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/evidence"}},
    "blockers": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/blocker"}},
    "downstream_brief": {"$ref": "#/$defs/downstreamBrief"},
    "requested_actions": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/requestedAction"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "shortText": {"type": "string", "minLength": 1, "maxLength": 500},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal_id", "work_unit_id"],
      "properties": {
        "goal_id": {"$ref": "#/$defs/id"},
        "work_unit_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "actor_id"],
      "properties": {
        "role": {"$ref": "#/$defs/id"},
        "actor_id": {"$ref": "#/$defs/id"}
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "summary"],
      "properties": {
        "state": {"enum": ["completed", "partial", "blocked", "paused", "failed"]},
        "summary": {"$ref": "#/$defs/shortText"}
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "evidence_ids"],
      "properties": {
        "statement": {"$ref": "#/$defs/shortText"},
        "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "basis"],
      "properties": {
        "statement": {"$ref": "#/$defs/shortText"},
        "basis": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}
      }
    },
    "changedPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "operation", "summary"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 240},
        "operation": {"enum": ["added", "modified", "deleted"]},
        "summary": {"$ref": "#/$defs/shortText"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "outcome", "detail", "evidence_ids"],
      "properties": {
        "name": {"$ref": "#/$defs/shortText"},
        "outcome": {"enum": ["passed", "failed", "skipped", "not-run"]},
        "detail": {"$ref": "#/$defs/shortText"},
        "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "locator", "summary"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["artifact", "command", "file", "note", "url"]},
        "locator": {"type": "string", "minLength": 1, "maxLength": 1000},
        "summary": {"$ref": "#/$defs/shortText"}
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "summary", "next_action"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "severity": {"enum": ["info", "warning", "blocking"]},
        "summary": {"$ref": "#/$defs/shortText"},
        "next_action": {"$ref": "#/$defs/shortText"}
      }
    },
    "downstreamBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "context", "constraints", "recommended_next_steps"],
      "properties": {
        "objective": {"$ref": "#/$defs/shortText"},
        "context": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/shortText"}},
        "constraints": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/shortText"}},
        "recommended_next_steps": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/shortText"}}
      }
    },
    "requestedAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "rationale", "requires_human_approval"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "action": {"$ref": "#/$defs/shortText"},
        "rationale": {"$ref": "#/$defs/shortText"},
        "requires_human_approval": {"type": "boolean"}
      }
    }
  }
}
