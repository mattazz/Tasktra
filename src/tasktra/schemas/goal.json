{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tasktra goal",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "description", "status", "authority", "acceptance"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "status": {"enum": ["planned", "active", "paused", "blocked", "complete", "stopped"]},
    "priority": {"type": "integer"},
    "authority": {"type": "object"},
    "acceptance": {"type": "array", "items": {"type": "string"}},
    "budget_tokens": {"type": ["integer", "null"], "minimum": 0},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1}
  }
}
