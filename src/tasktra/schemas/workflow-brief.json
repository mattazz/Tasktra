{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tasktra compact workflow brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "source", "target_role", "objective", "verified_facts", "evidence_refs", "constraints", "recommended_next_steps", "source_handoff_id"],
  "properties": {
    "kind": {"const": "tasktra.workflow-brief"},
    "version": {"const": 1},
    "source": {"$ref": "#/$defs/source"},
    "target_role": {"enum": ["scout", "writer", "implementer", "tester", "reviewer", "goal-steward", "escalation"]},
    "objective": {"$ref": "#/$defs/text"},
    "verified_facts": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/fact"}},
    "evidence_refs": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/evidence"}},
    "constraints": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/text"}},
    "recommended_next_steps": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/text"}},
    "source_handoff_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 500},
    "fact": {"type": "object", "additionalProperties": false, "required": ["statement", "evidence_ids"], "properties": {"statement": {"$ref": "#/$defs/text"}, "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "locator", "summary"], "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["artifact", "command", "file", "note", "url"]}, "locator": {"type": "string", "minLength": 1, "maxLength": 1000}, "summary": {"$ref": "#/$defs/text"}}},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal_id", "work_unit_id"],
      "properties": {"goal_id": {"$ref": "#/$defs/id"}, "work_unit_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}}
    }
  }
}
