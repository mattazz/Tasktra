{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tasktra pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["pack"],
  "properties": {
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "contract_version", "trust", "dependencies", "conflicts", "roles", "skills", "owns", "required_capabilities", "optional_capabilities", "validation_commands", "detection_markers", "detection_globs"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "contract_version": {"type": "integer", "minimum": 1},
        "trust": {"enum": ["builtin-data-only", "third-party-data-only", "third-party-executable"]},
        "dependencies": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "conflicts": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "roles": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "skills": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "owns": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "required_capabilities": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "optional_capabilities": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "validation_commands": {"type": "array", "maxItems": 32, "items": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1}}},
        "detection_markers": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "detection_globs": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        ,"activation_conditions": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        ,"workflows": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        ,"schemas": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        ,"policies": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        ,"adapters": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        ,"tests": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "migration": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "kind", "description"],
        "properties": {
          "from": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "to": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "kind": {"enum": ["declarative", "executable"]},
          "description": {"type": "string", "minLength": 1},
          "argv": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1}},
          "network": {"type": "boolean"},
          "read_paths": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "write_paths": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    }
  }
}
