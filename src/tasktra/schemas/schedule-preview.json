{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tasktra read-only schedule preview",
  "type": "object", "additionalProperties": false,
  "required": ["kind", "version", "action", "mutation", "cadence", "adapter", "available_adapters", "local_work_can_continue", "provider_data_is_authority", "invocation", "prompt", "limitations", "plan_sha256"],
  "properties": {"kind": {"const": "tasktra.schedule-preview"}, "version": {"const": 1}, "action": {"const": "schedule-preview"}, "mutation": {"const": "none"}, "cadence": {"type": "string", "minLength": 1, "maxLength": 200}, "adapter": {"$ref": "#/$defs/adapter"}, "available_adapters": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/adapter"}}, "local_work_can_continue": {"const": true}, "provider_data_is_authority": {"const": false}, "invocation": {"$ref": "#/$defs/invocation"}, "prompt": {"type": "string", "minLength": 1, "maxLength": 2000}, "limitations": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 500}}, "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "$defs": {"adapter": {"type": "object", "additionalProperties": false, "required": ["id", "state", "available", "summary", "preferred_environment", "provider_data_is_authority", "can_create_schedule"], "properties": {"id": {"enum": ["codex-scheduled-tasks", "ci", "local-runner", "manual"]}, "state": {"enum": ["available", "unavailable", "misconfigured", "degraded"]}, "available": {"type": "boolean"}, "summary": {"type": "string", "minLength": 1, "maxLength": 500}, "preferred_environment": {"type": "string", "minLength": 1, "maxLength": 100}, "provider_data_is_authority": {"const": false}, "can_create_schedule": {"const": false}}}, "invocation": {"type": "object", "additionalProperties": false, "required": ["kind", "version", "goal_id", "work_unit_id", "envelope_sha256", "checkpoint_id", "budget_reference", "lease", "recovery", "notification_intent", "authority", "idempotency_key"], "properties": {"kind": {"const": "tasktra.schedule-invocation"}, "version": {"const": 1}, "goal_id": {"type": "string", "minLength": 1, "maxLength": 64}, "work_unit_id": {"type": "string", "minLength": 1, "maxLength": 64}, "envelope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "checkpoint_id": {"type": ["string", "null"]}, "budget_reference": {"type": "object", "additionalProperties": false, "required": ["sha256", "snapshot"], "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "snapshot": {"type": "object"}}}, "lease": {"type": "object"}, "recovery": {"type": "object"}, "notification_intent": {"enum": ["none", "on-failure", "always"]}, "authority": {"const": "persisted-ledger-only"}, "idempotency_key": {"type": "string", "pattern": "^schedule-[0-9a-f]{40}$"}}}}
}
