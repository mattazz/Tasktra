{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tasktra approval",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal_id", "decision", "authority_clause", "rationale", "approver_id", "performer_id"],
  "properties": {
    "goal_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "work_unit_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "decision": {"enum": ["approved", "rejected", "needs_human_review"]},
    "authority_clause": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "receipt": {"type": "object"},
    "approver_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "performer_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "created_at": {"type": "string", "minLength": 1}
  }
}
