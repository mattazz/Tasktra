{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tasktra project profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["project"],
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "config_version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "config_version": {"const": 1}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "database": {"type": "string", "minLength": 1},
        "concurrency_limit": {"type": "integer", "minimum": 1}
      }
    },
    "packs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trust_builtin": {"type": "boolean"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include_pack_defaults": {"type": "boolean"},
        "commands": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": false
          },
          "uniqueItems": true
        }
      }
    }
  }
}
