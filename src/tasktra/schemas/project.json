{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tasktra project profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["project"],
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "config_version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "config_version": {"const": 1}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "database": {"type": "string", "minLength": 1},
        "concurrency_limit": {"type": "integer", "minimum": 1}
      }
    },
    "packs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trust_builtin": {"type": "boolean"}
      }
    },
    "agents": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "codex": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "model_tiers": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
            "roles": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "properties": {"model": {"type": "string", "minLength": 1}, "reasoning_effort": {"type": "string", "minLength": 1}}, "minProperties": 1}}
          }
        }
      }
    },
    "routing": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "routes": {
          "type": "array", "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "trigger"],
            "properties": {
              "id": {"type": "string", "minLength": 1, "maxLength": 64},
              "trigger": {"type": "string", "minLength": 1, "maxLength": 240},
              "role": {"type": "string", "minLength": 1, "maxLength": 64},
              "roles": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "string", "minLength": 1, "maxLength": 64}, "uniqueItems": true},
              "skills": {"type": "array", "maxItems": 6, "items": {"type": "string", "minLength": 1, "maxLength": 100}, "uniqueItems": true},
              "boundary": {"type": "string", "minLength": 1, "maxLength": 400}
            }
          }
        }
      }
    },
    "jira_sync": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "project", "claim_transition", "complete_transition"],
      "properties": {
        "host": {"type": "string", "minLength": 1, "maxLength": 253},
        "project": {"type": "string", "minLength": 1, "maxLength": 32},
        "claim_transition": {"type": "string", "minLength": 1, "maxLength": 240},
        "review_transition": {"type": "string", "minLength": 1, "maxLength": 240},
        "complete_transition": {"type": "string", "minLength": 1, "maxLength": 240}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include_pack_defaults": {"type": "boolean"},
        "commands": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": false
          },
          "uniqueItems": true
        }
      }
    }
  }
}
